diff --git a/PKGBUILD b/PKGBUILD
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -5,7 +5,7 @@
 # Check https://github.com/containers/libkrunfw/blob/main/Makefile#L1 for kernel version
 _kver=6.12.68
 pkgver=5.6.2
-pkgrel=1
+pkgrel=1.1
 pkgdesc="A dynamic library bundling the guest payload consumed by libkrun"
 url="https://github.com/containers/libkrunfw"
 arch=('x86_64')
@@ -25,7 +25,14 @@ build() {
   mkdir tarballs
   cp -s "$srcdir/linux-${_kver}.tar.xz" tarballs/
 
+  sed -i 's/^# CONFIG_NF_CONNTRACK_MARK is not set$/CONFIG_NF_CONNTRACK_MARK=y/' \
+    config-libkrunfw_x86_64
+  grep -qx 'CONFIG_NF_CONNTRACK_MARK=y' config-libkrunfw_x86_64
+
   make
+
+  # Verify that olddefconfig retained the requested option.
+  grep -qx 'CONFIG_NF_CONNTRACK_MARK=y' linux-*/.config
 }
 
 package() {
